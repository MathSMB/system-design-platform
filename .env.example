# Copie para .env (na raiz). Vale para todos os apps. Tudo aqui é opcional.

# Banco: sem DATABASE_URL, os apps usam o Postgres do docker-compose
# (postgres://sdp:sdp@localhost:5434/sdp), que o `pnpm dev` sobe sozinho.
# DATABASE_URL=postgres://sdp:sdp@localhost:5434/sdp

# Login único: o segredo que assina o cookie da conta. Todos os apps usam o mesmo.
# Sem ele, vale um segredo de desenvolvimento (ok para uso só no seu computador).
# AUTH_SECRET=troque-por-um-texto-longo-e-aleatorio

# IA: "claude-code" usa o Claude Code logado com a sua assinatura (só local).
#     "api" usa a API da Anthropic (precisa de ANTHROPIC_API_KEY).
AI_PROVIDER=claude-code
# CLAUDE_CODE_MODEL=opus
# ANTHROPIC_API_KEY=

# Entrar com GitHub e com Google (opcional). Passo a passo: docs/login-github-google.md
# Sem as chaves, o cadastro por nome e e-mail continua funcionando.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Projetos ligados ao GitHub (Central de estudos): chave que criptografa o token só leitura
# salvo no banco. Sem ela, a chave sai do AUTH_SECRET. Trocar a chave invalida os tokens salvos.
# GITHUB_TOKEN_KEY=troque-por-um-texto-longo-e-aleatorio
